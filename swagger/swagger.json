{
    "openapi": "3.0.0",
    "info": {
        "title": "Campus Study Hub API",
        "version": "1.0.0",
        "description": "API for managing study groups, users, sessions, and resources."
    },
    "servers": [
        {
            "url": "http://localhost:8080",
            "description": "Local server"
        },
        {
            "url": "https://your-render-app-url.onrender.com",
            "description": "Production server"
        }
    ],
    "paths": {
        "/users": {
            "get": {
                "summary": "Get all users",
                "responses": {
                    "200": {
                        "description": "List of users retrieved successfully"
                    },
                    "500": {
                        "description": "Server error"
                    }
                }
            },
            "post": {
                "summary": "Create a new user",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "firstName": {
                                        "type": "string",
                                        "example": "John"
                                    },
                                    "lastName": {
                                        "type": "string",
                                        "example": "Doe"
                                    },
                                    "email": {
                                        "type": "string",
                                        "example": "john@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "secret123"
                                    },
                                    "role": {
                                        "type": "string",
                                        "example": "student"
                                    },
                                    "major": {
                                        "type": "string",
                                        "example": "Computer Science"
                                    }
                                },
                                "required": [
                                    "firstName",
                                    "lastName",
                                    "email",
                                    "password",
                                    "major"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "User created successfully"
                    },
                    "400": {
                        "description": "Bad Request / Missing required fields"
                    }
                }
            }
        },
        "/users/{id}": {
            "get": {
                "summary": "Get user by ID",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "User details retrieved"
                    },
                    "404": {
                        "description": "User not found"
                    },
                    "500": {
                        "description": "Server error / Invalid ID format"
                    }
                }
            },
            "put": {
                "summary": "Update user by ID",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "firstName": {
                                        "type": "string"
                                    },
                                    "lastName": {
                                        "type": "string"
                                    },
                                    "email": {
                                        "type": "string"
                                    },
                                    "role": {
                                        "type": "string"
                                    },
                                    "major": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "204": {
                        "description": "User updated successfully (No Content)"
                    },
                    "400": {
                        "description": "Bad request"
                    },
                    "404": {
                        "description": "User not found"
                    }
                }
            },
            "delete": {
                "summary": "Delete user by ID",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "User deleted successfully"
                    },
                    "404": {
                        "description": "User not found"
                    },
                    "500": {
                        "description": "Server error"
                    }
                }
            }
        },
        "/groups": {
            "get": {
                "summary": "Get all study groups",
                "responses": {
                    "200": {
                        "description": "List of study groups retrieved successfully"
                    },
                    "500": {
                        "description": "Server error"
                    }
                }
            },
            "post": {
                "summary": "Create a new study group",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "CSE 341 Group 1"
                                    },
                                    "course": {
                                        "type": "string",
                                        "example": "CSE 341"
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "Web Services study team"
                                    },
                                    "ownerId": {
                                        "type": "string",
                                        "example": "650c1f1e2f3a4b5c6d7e8f90"
                                    },
                                    "members": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "required": [
                                    "name",
                                    "course",
                                    "description",
                                    "ownerId"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Study group created successfully"
                    },
                    "400": {
                        "description": "Bad Request / Missing required fields"
                    }
                }
            }
        },
        "/groups/{id}": {
            "get": {
                "summary": "Get study group by ID",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Study group details retrieved"
                    },
                    "404": {
                        "description": "Study group not found"
                    },
                    "500": {
                        "description": "Server error / Invalid ID format"
                    }
                }
            },
            "put": {
                "summary": "Update study group by ID",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "course": {
                                        "type": "string"
                                    },
                                    "description": {
                                        "type": "string"
                                    },
                                    "members": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "204": {
                        "description": "Study group updated successfully (No Content)"
                    },
                    "400": {
                        "description": "Bad request"
                    },
                    "404": {
                        "description": "Study group not found"
                    }
                }
            },
            "delete": {
                "summary": "Delete study group by ID",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Study group deleted successfully"
                    },
                    "404": {
                        "description": "Study group not found"
                    },
                    "500": {
                        "description": "Server error"
                    }
                }
            }
        }
    }
}